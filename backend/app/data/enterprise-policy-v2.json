{
  "version": "enterprise-demo-v2",
  "title": "中小企业费用报销测试制度",
  "simulated": true,
  "effective_date": "2026-11-11",
  "parameters": {
    "auto_limit": "1000.00", "claim_limit": "5000.00", "expense_days": 30,
    "hotel": {"staff": {"A": "500.00", "B": "400.00", "C": "300.00"}, "manager": {"A": "650.00", "B": "500.00", "C": "400.00"}},
    "cities": {"A": ["北京", "上海", "广州", "深圳"], "B": ["天津", "重庆", "杭州", "南京", "成都", "武汉", "西安", "苏州"], "C": ["珠海", "佛山", "东莞", "无锡", "常州", "扬州", "洛阳", "桂林", "大理", "嘉兴", "绍兴"]},
    "entertainment_person": "200.00", "entertainment_event": "2000.00", "phone_limit": "100.00",
    "meal_day": "100.00", "breakfast": "20.00", "lunch": "40.00", "dinner": "40.00"
  },
  "categories": ["交通费", "住宿费", "业务招待费", "办公用品", "通讯费", "培训会议费", "软件服务费", "出差餐补", "其他"],
  "rules": [
    {"id":"GEN-01","categories":["*"],"text":"费用须与业务相关，填写部门、项目、日期和用途；缺少材料交人工核对。"},
    {"id":"GEN-02","categories":["*"],"text":"申报金额大于0且不超过5000元，最多两位小数，票面总额独立保存。"},
    {"id":"GEN-03","categories":["*"],"text":"无风险且申报不超1000元、有效模型意见为通过时可自动初审；超阈值交人工。"},
    {"id":"GEN-04","categories":["*"],"text":"费用发生后30个自然日内正常申报；超期须说明并由人工审批。"},
    {"id":"GEN-06","categories":["*"],"text":"申报不得超过项目可用预算；人工通过前再次查询预算。"},
    {"id":"GEN-07","categories":["*"],"text":"原件、确认、依据、工具、审批和修订均归档，禁止本人审批和重复生效。"},
    {"id":"INV-01","categories":["*"],"text":"申报关联本人原票或餐补出差证明，关键票面字段缺失时转人工补充。"},
    {"id":"INV-02","categories":["*"],"text":"数电票号20位，传统票号8位并核对发票代码；格式检查与真实性查验分别记录。"},
    {"id":"INV-03","categories":["*"],"text":"购买方与企业抬头核对，抬头不符交人工，销售方与提交人分别保存。"},
    {"id":"INV-04","categories":["*"],"text":"模拟台账无效票据拒绝，未知结果交人工；模拟查验不代表真实税务验真。"},
    {"id":"INV-05","categories":["*"],"text":"同票已报销或被其他处理中申请占用不得重复报销；原任务退回重提排除自身。"},
    {"id":"INV-06","categories":["*"],"text":"同员工、日期、金额但不同票号视为疑似重复，交人工核对。"},
    {"id":"INV-07","categories":["*"],"text":"一票一单；申报超过票额拒绝，部分申报须说明差异并转人工。"},
    {"id":"TRV-01","categories":["交通费"],"text":"铁路二等座或硬席、飞机经济舱按标准核对，超标准交人工。"},
    {"id":"TRV-02","categories":["交通费"],"text":"出租车、网约车提供因公路线或行程材料。"},
    {"id":"TRV-03","categories":["住宿费"],"text":"住宿提供城市、入住离店日期、出差审批和住宿清单，晚数按日期差计算。"},
    {"id":"TRV-05","categories":["住宿费"],"text":"员工A/B/C类城市每晚500/400/300元，主管650/500/400元；超标准申请例外交人工。"},
    {"id":"ENT-01","categories":["业务招待费"],"text":"招待填写对象、事由、人数和事前审批，全部招待交人工。"},
    {"id":"ENT-02","categories":["业务招待费"],"text":"招待同时核对每人200元、每次2000元上限，超标须说明。"},
    {"id":"OFF-01","categories":["办公用品"],"text":"办公用品提供收货或明细，超1000元须采购审批。"},
    {"id":"TEL-01","categories":["通讯费"],"text":"通讯说明月份及业务用途，单次100元限额，按月人工核对。"},
    {"id":"EDU-01","categories":["培训会议费"],"text":"培训、会议、报名费说明活动和业务关联并提供审批，交人工。"},
    {"id":"IT-01","categories":["软件服务费"],"text":"软件、云资源、API及技术服务填写服务期间和采购审批或合同，交人工。"},
    {"id":"MEAL-01","categories":["出差餐补"],"text":"出差餐补每天100元，提供出差日期和审批证明，交人工。"},
    {"id":"MEAL-02","categories":["出差餐补"],"text":"已供早餐、午餐、晚餐分别扣20、40、40元，避免同餐重复领取。"},
    {"id":"OTH-01","categories":["其他"],"text":"未覆盖费用保留原项目名称，由人工确认具体制度依据。"}
  ]
}
