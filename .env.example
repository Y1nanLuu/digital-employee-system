# 本地课程演示凭据，请勿用于真实生产
DEMO_PASSWORD=demo123
FINANCE_KEY=local-finance-key
POSTGRES_PASSWORD=local-postgres-password
APP_VERSION=0.5.0
APP_STAGE=enterprise-review
ACTIVE_POLICY_VERSION=enterprise-demo-v3
COMPANY_TITLE=示例科技有限公司
# 默认相对backend目录
FILE_STORAGE_DIR=./data/invoices

# 实际大模型用于字段解析及结构化初审；启用时填写密钥
AI_MODULE_ENABLED=false
AI_MODULE_CONFIG=ai-module/model_config.deepseek.json
DEEPSEEK_API_KEY=
# 或将密钥保存在已忽略的dsapi.txt；不得提交Git
# 不可用时转人工；图片和PDF读取走本地OCR，无需独立OCR密钥

# 可选容器部署的独立开关；Compose已只读挂载ai-module
COMPOSE_AI_MODULE_ENABLED=false
# 可选新制度JSON，必须发布新version
# ENTERPRISE_POLICY_FILE=
# 如使用其他模型通道，自行配置本机覆盖文件及相应密钥
# GLM_API_KEY=
