# 仅用于本地课程演示，请勿使用真实用户凭据。
DEMO_PASSWORD=demo123
FINANCE_KEY=local-finance-key
POSTGRES_PASSWORD=local-postgres-password
# 集成版本标识（GET /health 暴露，便于验收核对运行版本）
APP_VERSION=0.3.0
APP_STAGE=D3-integration

# ---- 字段提取模型通道 ----
# 默认关闭，关闭时走内置规则基线，行为与未接入完全一致。
AI_MODULE_ENABLED=false

# 想用真实模型（DeepSeek）时，把上面改成 true，并启用下面两行：
#   1) AI_MODULE_CONFIG 指向仓库内的远程通道覆盖配置（默认配置保持本地通道不动）：
# AI_MODULE_CONFIG=ai-module/model_config.deepseek.json
#   2) 密钥二选一，切勿写入配置文件：
#      a. 在项目根目录放 dsapi.txt（已 gitignore），dev.ps1 会自动读取为 DEEPSEEK_API_KEY；
#      b. 或直接在这里填：DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_API_KEY=
# GLM_API_KEY=
# 备注：模型不可用或密钥缺失时适配层自动降级为规则提取，任务会转人工，不会阻断提交。
