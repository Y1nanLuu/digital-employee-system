# 仅用于本地课程演示，请勿使用真实用户凭据。
DEMO_PASSWORD=demo123
FINANCE_KEY=local-finance-key
POSTGRES_PASSWORD=local-postgres-password
# 字段提取接入 ai-module 的模型通道（默认关闭，关闭时走规则基线）。
# 打开前先启动 ai-module 的本地模型服务（scripts/dev.ps1 ai，端口8010）；
# 服务不可用时适配层会自动降级为规则提取，不影响提交链路。
AI_MODULE_ENABLED=false
# 可选：覆盖模型通道配置路径，默认 ai-module/model_config.json
# AI_MODULE_CONFIG=E:\path\to\model_config.json
# 集成版本标识（GET /health 暴露，便于验收核对运行版本）
APP_VERSION=0.3.0
APP_STAGE=D3-integration
